rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // El rol/activo vive en el doc propio de /users — nunca en un custom claim. Esto es a
    // propósito: setear custom claims requiere Admin SDK (Cloud Function o script local), que
    // en plan Spark no se puede desplegar. Leyendo el doc propio, admin puede crear/activar/
    // desactivar/eliminar usuarios 100% desde el panel, sin backend privilegiado.
    // Sigue siendo seguro contra auto-escalado: para escribir CUALQUIER /users/{id} (incluido
    // el propio) hace falta que el doc propio YA diga rol == 'admin' — un comercial no puede
    // promoverse a sí mismo porque la condición se evalúa contra lo que ya está guardado, no
    // contra lo que intenta escribir.
    function estaAutenticado() {
      return request.auth != null;
    }
    function perfilPropio() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function esAdmin() {
      return estaAutenticado() && perfilPropio().rol == 'admin' && perfilPropio().activo == true;
    }
    function esComercialOAdmin() {
      return estaAutenticado() && perfilPropio().activo == true
        && (perfilPropio().rol == 'comercial' || perfilPropio().rol == 'admin');
    }

    // Perfiles de usuario (rol, nombre, activo). Cada persona puede leer el
    // suyo; solo el admin puede leer todos y escribir cualquiera.
    match /users/{userId} {
      allow read: if estaAutenticado() && (request.auth.uid == userId || esAdmin());
      allow write: if esAdmin();
    }

    // Inventario cargado desde el Excel diario. Todo el equipo comercial lo
    // lee; solo el admin puede crear, sobrescribir o borrar referencias.
    // Update además de create: cada carga reemplaza los valores de
    // referencias que ya existen. Delete: el admin puede limpiar el stock
    // actual antes de subir un Excel nuevo (referencias que ya no existen
    // en el sistema quedarían obsoletas para siempre si no se pudiera). La
    // resta por despacho NO pasa por aquí de todos modos: la hace la Cloud
    // Function `registrarDespacho` con el Admin SDK, que escribe sin pasar
    // por estas reglas sin importar lo que digan — por eso darle al admin
    // create/update/delete aquí no abre ninguna puerta a saltarse la
    // transacción atómica del despacho.
    match /stock/{referenciaId} {
      allow read: if esComercialOAdmin();
      allow create, update, delete: if esAdmin();
    }

    // Registro de cada archivo cargado (para trazabilidad). Solo lectura
    // para el equipo, escritura solo desde la carga de Excel del admin.
    match /excelUploads/{uploadId} {
      allow read: if esComercialOAdmin();
      allow create: if esAdmin();
      allow update, delete: if false;
    }

    // Histórico de despachos. Se lee en la app; se escribe únicamente desde
    // la transacción de `registrarDespacho` (Admin SDK), nunca directo.
    match /movimientos/{movId} {
      allow read: if esComercialOAdmin();
      allow create, update, delete: if false;
    }

    // Mapeo de columnas del Excel recordado entre cargas.
    match /config/{docId} {
      allow read: if esAdmin();
      allow write: if esAdmin();
    }
  }
}
