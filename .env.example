# Configuración web de tu proyecto de Firebase.
# Firebase Console → Configuración del proyecto → Tus apps → App web → Config
# Copia este archivo a ".env" y pega los valores reales. Nunca subas ".env" a git.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend mínimo (server/) que crea/elimina usuarios con Admin SDK, desplegado aparte en
# Render. Opcional: si se omite, usa https://teo-stock-admin-api.onrender.com por defecto.
VITE_ADMIN_API_URL=
